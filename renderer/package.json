{
  "name": "lineage-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lineage renderer (PixiJS/WebGL): one scene for the desk kiosk and the phone.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "look": "vite build && node scripts/look-report.mjs look",
    "creatures": "vite build && node scripts/look-report.mjs creatures",
    "land": "vite build && node scripts/land-report.mjs",
    "protocol": "node scripts/protocol.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
