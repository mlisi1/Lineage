# Runs the island in real time on the board (S1, ADR 0023), as user %i: the sim, its saves
# under ~<user>/lineage-data, the kiosk's pages and the state stream on port 8080.
#
#   sudo cp lineage-server@.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now lineage-server@<user>
#   sudo journalctl -fu lineage-server@<user>      # the hourly status lines among the rest
#   curl -s localhost:8080/status                  # the same numbers, now
#
# It expects ~<user>/lineage/ to hold a checkout of the repository with its environment
# (`uv sync --no-dev`) and the desk's build (`cd renderer && npm run build:kiosk`, or
# dist-kiosk/ copied from a PC). The device is the keyboard fake until S2; with no
# keyboard it is simply the owner at the desk. S6 makes this the deployment's own unit.
#
# The board has no clock of its own: until the network gives it the time it may think it
# is long ago, and the island would wait for that moment, or catch up on time that never
# passed if it is set ahead. So the server starts once the time is synchronised
# (`sudo systemctl enable systemd-time-wait-sync` makes time-sync.target mean that).
[Unit]
Description=Lineage island in real time, as %i
Wants=time-sync.target network-online.target
After=time-sync.target network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/lineage
# So that each log line reaches the journal as it is written.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/lineage/.venv/bin/python -m lineage_server.main --data /home/%i/lineage-data --dist renderer/dist-kiosk --fake-device
StandardInput=null
# SIGTERM saves and stops; a save takes about 2 s at most on the board (CLAUDE.md §4.8).
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
