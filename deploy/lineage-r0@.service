# Runs the R0 renderer benchmark once, full screen on the board's display, as user %i.
#
#   sudo cp lineage-r0@.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl start lineage-r0@<user>      # takes the screen for about 15 minutes
#   sudo journalctl -fu lineage-r0@<user>       # the tables, as they are printed
#
# It expects ~<user>/lineage-r0/ to hold kiosk_bench.py and dist/ (see board-setup.md),
# and leaves kiosk-bench.json there. cage is a Wayland compositor that shows one
# application full screen and ends when it does: here the runner, whose Chromium windows
# it shows. The unit takes the first console for itself; `sudo systemctl start
# getty@tty1` gives the login prompt back afterwards.
[Unit]
Description=Lineage R0 renderer benchmark on the display, as %i
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/lineage-r0
# A login session on the first console: what gives cage the display and the GPU.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
# So that each table reaches the journal as it is printed, not when the run is over.
Environment=PYTHONUNBUFFERED=1
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /usr/bin/python3 kiosk_bench.py --dist dist
Restart=no
